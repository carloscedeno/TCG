{
  "userIgnoreFilters": [
    "node_modules/**",
    ".git/**",
    ".venv/**",
    "__pycache__/**",
    ".pytest_cache/**",
    "backup_before_restructure/**",
    "pg17/**",
    "pg17.zip",
    "dist/**",
    ".gemini/**",
    ".StrataFramework/**",
    ".agent/**",
    ".code-review-graph/**",
    "scratch/**",
    "logs/**",
    "*.backup",
    "*.backup.gz",
    "dev_data_dump.sql",
    "dev_data_dump_tail.sql",
    "test_results_*.json",
    "scraper.log"
  ],
  "attachmentFolderPath": "docs/attachments",
  "newLinkFormat": "relative",
  "useMarkdownLinks": false,
  "showLineNumber": true,
  "showIndentGuide": true,
  "readableLineLength": false,
  "spellcheck": false,
  "promptDelete": false,
  "tabSize": 2,
  "autoPairMarkdown": true,
  "autoPairBrackets": true,
  "smartIndentList": true,
  "livePreview": true,
  "alwaysUpdateLinks": true
}